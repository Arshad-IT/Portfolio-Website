# Static Assets (Images, Icons, CSS, JS, Fonts) - Cache for 1 year immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/site.webmanifest
  Cache-Control: public, max-age=604800

# HTML pages - check for updates immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
